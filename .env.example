# Copy to .env and fill in. Never commit .env.

# Claude API key for the agent.
ANTHROPIC_API_KEY=

# API port (the code falls back to 3000 when unset).
PORT=

# SQLite file path (planned default: apps/api/data/dev.db).
DATABASE_PATH=

# SMTP host for outgoing mail (Mailpit locally: localhost).
SMTP_HOST=

# SMTP port (Mailpit: 1025).
SMTP_PORT=

# Mailpit HTTP API base URL, used to read received mail (locally: http://localhost:8025).
MAILPIT_API_URL=
